# ClusterCloud Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ==========================================
# API Configuration
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
LOG_LEVEL=INFO

# ==========================================
# Database Configuration
# ==========================================
# Production: PostgreSQL
DATABASE_URL=postgresql://clustercloud:changeme@localhost:5432/clustercloud

# Development fallback: SQLite
# DATABASE_URL=sqlite:///./clustercloud.db

# ==========================================
# Authentication
# ==========================================
# Generate with: openssl rand -hex 32
JWT_SECRET=your-secret-key-here-change-in-production
API_KEY_NODE_AGENT=your-node-agent-api-key-here

# ==========================================
# AWS Bedrock Configuration
# ==========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# ==========================================
# Node Agent Configuration
# ==========================================
CONTROL_PLANE_URL=http://localhost:8000
NODE_AGENT_ID=auto
NODE_AGENT_API_KEY=your-node-agent-api-key-here
HEARTBEAT_INTERVAL_SECONDS=5
MAX_CONCURRENT_TASKS=2

# ==========================================
# Workload Execution
# ==========================================
DOCKER_NETWORK=clustercloud_network
WORKLOAD_TIMEOUT_SECONDS=300
TASK_TIMEOUT_SECONDS=120

# ==========================================
# Tokenomics (CLSTR)
# ==========================================
INITIAL_CUSTOMER_BALANCE=10000
PROVIDER_RELIABILITY_STAKE=100
BROKER_FEE_PERCENTAGE=5
FAILURE_PENALTY_PERCENTAGE=20
RECOVERY_REWARD_PERCENTAGE=10

# ==========================================
# Monitoring & Reliability
# ==========================================
HEARTBEAT_TIMEOUT_SECONDS=15
MAX_TASK_RETRIES=3
NODE_HEALTH_CHECK_INTERVAL_SECONDS=10

# ==========================================
# Frontend Configuration
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
