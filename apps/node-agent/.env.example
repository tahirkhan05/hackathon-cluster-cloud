# ClusterCloud Node Agent Configuration

# ============================================================
# CRITICAL: For Two-Laptop Demo
# ============================================================
# Replace localhost with Laptop A's IP address
# Example: CONTROL_PLANE_URL=http://192.168.1.100:8000
CONTROL_PLANE_URL=http://localhost:8000

# ============================================================
# Node Identity
# ============================================================
# Unique identifier for this node (optional - will auto-generate if not provided)
# Use descriptive names for demo: laptop-b-node, desktop-1, etc.
NODE_AGENT_ID=auto

# ============================================================
# Authentication
# ============================================================
# API key for node authentication (required if ENABLE_NODE_AUTH=true on backend)
NODE_AGENT_API_KEY=dev-node-agent-key

# ============================================================
# Heartbeat Configuration
# ============================================================
# How often to send heartbeat signals (seconds)
HEARTBEAT_INTERVAL_SECONDS=5
# How long to wait for heartbeat response (seconds)
HEARTBEAT_TIMEOUT_SECONDS=10
# Max consecutive heartbeat failures before shutdown
MAX_HEARTBEAT_FAILURES=3

# ============================================================
# Node Capacity
# ============================================================
# Maximum number of concurrent tasks this node can handle
MAX_CONCURRENT_TASKS=2
# Cost per task in CLSTR tokens
COST_PER_TASK_CLSTR=10.0

# ============================================================
# Logging
# ============================================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================================
# Demo/Testing Settings
# ============================================================
# Simulate failure after N seconds (for testing)
SIMULATE_FAILURE=false
FAILURE_AFTER_SECONDS=30

