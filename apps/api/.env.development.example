# ClusterCloud API - Development Environment
# DO NOT use these settings in production

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
LOG_LEVEL=DEBUG

# Database
DATABASE_URL=sqlite:///./clustercloud.db

# Security (Development - Auth Disabled)
ENABLE_NODE_AUTH=false
NODE_API_KEY=dev-key-change-in-production
JWT_SECRET=dev-secret-change-in-production

# Resource Limits (Permissive for development)
MAX_TASK_MEMORY_MB=2048
MAX_TASK_CPU_CORES=2.0
MAX_TASK_DISK_MB=5120

# Docker Security
ENABLE_DOCKER_ISOLATION=true
DOCKER_SECURITY_OPT=no-new-privileges:true

# AWS Bedrock (Optional - AI features)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Tokenomics
INITIAL_CUSTOMER_BALANCE=10000
PROVIDER_RELIABILITY_STAKE=100
BROKER_FEE_PERCENTAGE=5
FAILURE_PENALTY_PERCENTAGE=20
RECOVERY_REWARD_PERCENTAGE=10

# Monitoring
HEARTBEAT_TIMEOUT_SECONDS=15
HEARTBEAT_INTERVAL_SECONDS=5
NODE_HEALTH_CHECK_INTERVAL_SECONDS=10

# Task Execution
TASK_TIMEOUT_SECONDS=120
WORKLOAD_TIMEOUT_SECONDS=300
MAX_TASK_RETRIES=3
MAX_CONCURRENT_TASKS=2

# File Retention
EPHEMERAL_FILE_RETENTION_HOURS=24
