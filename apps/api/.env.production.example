# ClusterCloud API - Production Environment
# CRITICAL: Change all secrets before deploying

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=8
LOG_LEVEL=INFO

# Database (Use PostgreSQL in production)
DATABASE_URL=postgresql://user:password@localhost:5432/clustercloud

# Security (REQUIRED IN PRODUCTION)
ENABLE_NODE_AUTH=true
NODE_API_KEY=<generate-secure-random-key-64-chars>
JWT_SECRET=<generate-secure-random-key-64-chars>

# Generate secure keys:
# python -c "import secrets; print(secrets.token_hex(32))"

# Resource Limits (Stricter for production)
MAX_TASK_MEMORY_MB=1024
MAX_TASK_CPU_CORES=1.0
MAX_TASK_DISK_MB=2048

# Docker Security (MUST be enabled)
ENABLE_DOCKER_ISOLATION=true
DOCKER_SECURITY_OPT=no-new-privileges:true

# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<from-secrets-manager>
AWS_SECRET_ACCESS_KEY=<from-secrets-manager>
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Tokenomics
INITIAL_CUSTOMER_BALANCE=10000
PROVIDER_RELIABILITY_STAKE=100
BROKER_FEE_PERCENTAGE=5
FAILURE_PENALTY_PERCENTAGE=20
RECOVERY_REWARD_PERCENTAGE=10

# Monitoring
HEARTBEAT_TIMEOUT_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=10
NODE_HEALTH_CHECK_INTERVAL_SECONDS=30

# Task Execution
TASK_TIMEOUT_SECONDS=300
WORKLOAD_TIMEOUT_SECONDS=600
MAX_TASK_RETRIES=3
MAX_CONCURRENT_TASKS=4

# File Retention
EPHEMERAL_FILE_RETENTION_HOURS=1

# Production Checklist:
# [ ] Change all secret keys
# [ ] Enable NODE_AUTH
# [ ] Use PostgreSQL (not SQLite)
# [ ] Enable TLS/HTTPS
# [ ] Configure firewall rules
# [ ] Set up monitoring
# [ ] Configure backup strategy
# [ ] Review SECURITY.md
