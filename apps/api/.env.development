# Development environment configuration
# This file can be committed as it contains no secrets
# Copy to .env and customize as needed

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=DEBUG

# SQLite for quick development
DATABASE_URL=sqlite:///./clustercloud.db

# Development secrets (replace in production)
JWT_SECRET=dev-secret-key-change-in-production
API_KEY_NODE_AGENT=dev-node-agent-key

# AWS Bedrock (add your credentials)
AWS_REGION=us-east-1

# Node Agent
HEARTBEAT_INTERVAL_SECONDS=5
MAX_CONCURRENT_TASKS=2

# Workload
WORKLOAD_TIMEOUT_SECONDS=300
TASK_TIMEOUT_SECONDS=120

# Tokenomics
INITIAL_CUSTOMER_BALANCE=10000
PROVIDER_RELIABILITY_STAKE=100
BROKER_FEE_PERCENTAGE=5
FAILURE_PENALTY_PERCENTAGE=20
RECOVERY_REWARD_PERCENTAGE=10

# Monitoring
HEARTBEAT_TIMEOUT_SECONDS=15
MAX_TASK_RETRIES=3
NODE_HEALTH_CHECK_INTERVAL_SECONDS=10
